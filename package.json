{
  "name": "know-me",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "wrangler dev",
    "db:init": "wrangler d1 migrations apply know-me --local",
    "deploy": "pnpm build && wrangler deploy",
    "test": "node scripts/test.mjs",
    "preview:local": "node scripts/preview.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0",
    "@cloudflare/workers-types": "^4.0.0",
    "esbuild": "^0.25.12"
  }
}